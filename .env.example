# Model access is optional for API/auth and offline tests.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-sol
CONDITION_MODEL=
GENERAL_OPENAI_MODEL=gpt-4.1-mini
GENERAL_API_STYLE=responses
ENABLE_AI_INTENT_ROUTER=true
INTENT_MODEL=gpt-6-luna
INTENT_API_STYLE=responses
AUTO_MEMORY=true
# Keep sqlite until the offline snapshot is imported and verified.
MEMORY_BACKEND=sqlite
CONVERSATION_BACKEND=sqlite
# For Docker Compose product memory-store: postgresql://agent_memory:<password>@memory-store:5432/agent_memory
MEMORY_DATABASE_URL=
MEMORY_SCHEMA=memory
MEMORY_STORE_PASSWORD=local-memory-store-only
MEMORY_CUTOVER_MEMORY_SHA256=
MEMORY_CUTOVER_CONVERSATION_SHA256=
MEMORY_MONITOR_INTERVAL_SECONDS=5
MEMORY_MONITOR_MAX_PENDING=100
MEMORY_MONITOR_MAX_AGE_SECONDS=60
# Defaults to the Compose API. Override only for a separate deployment.
MEMORY_MONITOR_API_URL=http://api:8000/readyz
# Optional internal alert receiver. Empty means alerts are written only to Docker logs.
MEMORY_MONITOR_WEBHOOK_URL=
COLLABORATION_API_STYLE=responses
# Optional host-only synthetic answer evaluation; never enabled in product API.
# CITED_ANSWER_MODEL=gpt-6-sol
# CITED_ANSWER_API_STYLE=responses
# EVIDENCE_VERIFIER_MODEL=gpt-6-sol
# EVIDENCE_VERIFIER_API_STYLE=responses
UNSPLASH_ACCESS_KEY=
ENABLE_GPT_ANSWERS=false
AUTO_REFLECTION=true
AUTO_REACT=true

# Optional authorized-search candidate cache for benchmark/large catalogs.
# Use this internal hostname only when the API runs in Docker Compose.
# REDIS_CACHE_URL=redis://redis-cache:6379/0
# Record durable local shadow-index events. Run the separate worker to consume them.
SHADOW_INDEX_OUTBOX=false

# Local development only. Generate DEMO_PASSWORD_HASH with:
# py -c "from app.api.auth import hash_password; import getpass; print(hash_password(getpass.getpass()))"
APP_ENV=local
ENABLE_DEV_ACCOUNTS=false
DEMO_USERNAME=
DEMO_PASSWORD_HASH=
DEMO_USER_ID=
DEMO_ORG_ID=
DEMO_DEPARTMENTS=
DEMO_CLEARANCE=INTERNAL
DEMO_ROLE=employee
